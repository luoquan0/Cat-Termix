# Disposable integration test only.
# Core JS and UI come from this fork's own CI build; the matching official
# versioned image supplies Node native modules and bundled official plugins.
# The original docker/Dockerfile is unchanged and remains the future
# production-build authority once artifact CDN availability is restored.
FROM ghcr.io/termix-ssh/termix:26.11.0

WORKDIR /app
RUN rm -rf /app/html /app/dist/backend /app/packages/plugin-sdk/dist && \
    mkdir -p /app/html /app/dist/backend /app/packages/plugin-sdk/dist && \
    chown -R node:node /app/html /app/dist/backend /app/packages/plugin-sdk/dist
COPY --chown=node:node html/ /app/html/
COPY --chown=node:node backend/ /app/dist/backend/
COPY --chown=node:node sdk/ /app/packages/plugin-sdk/dist/
COPY --chown=node:node agent/ /app/dist/plugins/agent/
COPY patch-nginx-legacy-route.mjs /tmp/patch-nginx-legacy-route.mjs
RUN node /tmp/patch-nginx-legacy-route.mjs && rm /tmp/patch-nginx-legacy-route.mjs

# The Local Agent is intentionally recommended and enabled on a fresh beta
# volume so the owner can test pairing immediately. This is a disposable
# test image; never reuse a production data volume.
RUN node -e 'const fs=require("node:fs"); const file="/app/dist/plugins/bundled-index.json"; const index=JSON.parse(fs.readFileSync(file,"utf8")); index.plugins ??= {}; const previous=index.plugins.agent ?? {}; index.plugins.agent={...previous,onboarding:{...(previous.onboarding ?? {}),recommended:true,consent:false}}; fs.writeFileSync(file,JSON.stringify(index,null,2));'

LABEL org.opencontainers.image.title="Cat-Termix 26.11 Agent beta" \
      org.opencontainers.image.description="TEST ONLY: fork-built Termix 26.11 core with bundled official plugins and Cat Local Agent beta"
