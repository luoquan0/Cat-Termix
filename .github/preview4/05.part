n to chat.\",\n    \"contextSettings\": \"Context compression\",\n    \"contextUsage\": \"Context usage\",\n    \"contextShort\": \"Context\",\n    \"contextPending\": \"Context —\",\n    \"contextCompacting\": \"Compacting…\",\n    \"contextUsageDetail\": \"Estimated input {{tokens}} + reserved output {{reserve}} / configured capacity {{capacity}} tokens. Compactions: {{count}}. Last upstream input count: {{actual}}. This is a heuristic estimate, not a tokenizer measurement.\",\n    \"contextAutomatic\": \"Automatically summarize older context\",\n    \"contextCapacity\": \"Configured context capacity (tokens)\",\n    \"contextReserve\": \"Reserved response tokens\",\n    \"contextThreshold\": \"Compression threshold (%)\",\n    \"contextRecent\": \"Preferred recent turns to retain\",\n    \"contextExplanation\": \"Capacity must match your upstream model; it is not automatically detected. Usage estimates include system instructions, tool schemas, history and output reserve. At the threshold, older turns are summarized; long tool output can be shortened. Complete chat records remain stored. Summary calls use your selected model and incur API usage. Critical details can still be lost.\",\n    \"updateSettings\": \"Application updates (administrator)\",\n    \"updateLoadError\": \"Update configuration is unavailable.\",\n    \"updateActionError\": \"Update action failed. Check administrator permissions, proxy settings and the updater status.\",\n    \"updateScope\": \"Tracks only ghcr.io/luoquan0/cat-termix:ai-dev. Never replaces this fork with upstream Termix.\",\n    \"updateInstallHint\": \"Updater not connected. One-time setup: start Compose with docker-compose.ai-test.yml AND docker-compose.ai-updates.yml. The Docker socket belongs only to the separate updater.\",\n    \"updateAutomatic\": \"Automatically install published Cat-Termix builds\",\n    \"updateRestartWarning\": \"Updates restart the application and disconnect SSH sessions. In-flight AI requests are deferred. Only standard Docker + local SQLite is supported: a cold data snapshot is retained before replacement. Avoid editing data during maintenance.\",\n    \"updateInterval\": \"Check interval (hours)\",\n    \"updateProxy\": \"Update HTTP/HTTPS proxy\",\n    \"updateProxyHint\": \"Optional proxy origin, e.g. http://host.docker.internal:7890. Used for both version checks and image layers, with TLS verification. Saved credentials are masked; leave the field unchanged to retain them, clear it to disable proxy.\",\n    \"updateCheck\": \"Check now\",\n    \"updateApply\": \"Update now\",\n    \"updateConfirm\": \"Confirm restart and update\",\n    \"updateCurrent\": \"Current revision\",\n    \"updateAvailable\": \"Published revision\"\n"]]}, {"path": "plugins/ai/locales/translated/zh_CN.json", "sha256": "f948dcb65c40ea821e51457064bc57f50b61ea977ac3e61ab368c6b1d51cfae2", "edits": [[21, 21, "    },\n    \"manage_updates\": {\n      \"title\": \"管理软件更新\",\n      \"description\": \"配置并请求 Docker 自动更新，同时要求管理员设置权限。\"\n"], [148, 149, "    \"readingTerminalOutput\": \"正在读取终端输出\",\n    \"disableAutoHint\": \"点击恢复逐次审批。权限检查和审计日志保持开启。\",\n    \"enableAutoHint\": \"点击后，本会话的命令无需逐条确认即可自动执行，可能修改服务器。权限检查与审计日志仍保留。\",\n    \"settingsDialogHint\": \"在这个独立悬浮窗中调整配置，关闭后继续对话。\",\n    \"contextSettings\": \"上下文压缩\",\n    \"contextUsage\": \"上下文占用\",\n    \"contextShort\": \"上下文\",\n    \"contextPending\": \"上下文 —\",\n    \"contextCompacting\": \"压缩中…\",\n    \"contextUsageDetail\": \"估算输入 {{tokens}} + 预留回复 {{reserve}} / 配置容量 {{capacity}} Token。已压缩 {{count}} 次；上次上游实际输入：{{actual}}。这是启发式估算，不是精确分词统计。\",\n    \"contextAutomatic\": \"自动总结并压缩较早的上下文\",\n    \"contextCapacity\": \"模型上下文容量（Token）\",\n    \"contextReserve\": \"预留回复 Token\",\n    \"contextThreshold\": \"自动压缩阈值（%）\",\n    \"contextRecent\": \"优先保留最近对话轮数\",\n    \"contextExplanation\": \"容量须按实际上游模型填写，不是自动探测值。占用估算包含系统指令、工具定义、历史及回复预留；达到阈值后总结旧对话，必要时精简过长工具输出。完整聊天记录不删除。摘要使用当前模型，会消耗额外 API 用量，仍可能丢失细节。\",\n    \"updateSettings\": \"软件自动更新（管理员）\",\n    \"updateLoadError\": \"暂时无法读取更新配置。\",\n    \"updateActionError\": \"更新操作失败，请检查管理员权限、代理配置和更新器状态。\",\n    \"updateScope\": \"只跟踪 ghcr.io/luoquan0/cat-termix:ai-dev 魔改版，不会用原版 Termix 覆盖。\",\n    \"updateInstallHint\": \"未连接更新器。首次需同时使用 docker-compose.ai-test.yml 和 docker-compose.ai-updates.yml 启动。仅独立更新器挂载 Docker 套接字，聊天应用不挂载。\",\n    \"updateAutomatic\": \"自动安装已发布的 Cat-Termix 新构建\",\n    \"updateRestartWarning\": \"更新会重启应用并断开 SSH 会话，正在执行的 AI 请求会延后更新。支持标准 Docker 与本地 SQLite，替换前先做停机数据备份。维护期间请勿修改数据。\",\n    \"updateInterval\": \"检查间隔（小时）\",\n    \"updateProxy\": \"更新 HTTP / HTTPS 代理\",\n    \"updateProxyHint\": \"可留空，例如 http://host.docker.internal:7890。版本检查与镜像层下载都走此代理，保持 TLS 校验。已保存的代理密码不会回显；不修改则保留，清空则关闭代理。\",\n    \"updateCheck\": \"立即检查\",\n    \"updateApply\": \"立即更新\",\n    \"updateConfirm\": \"确认重启并更新\",\n    \"updateCurrent\": \"当前构建\",\n    \"updateAvailable\": \"已发布构建\"\n"]]}, {"path": "plugins/ai/manifest.json", "sha256": "3d061296ab3270d107d850bf3834870a6eb7bc6c2c88a88329bc3927630caa6c", "edits": [[27, 28, "    \"users:impersonate\",\n    \"files:own\"\n"], [98, 99, "        \"openFrom\": [\n          \"rail\",\n          \"palette\"\n        ]\n"], [117, 118, "        \"defaultRoles\": [\n          \"user\"\n        ]\n"], [123, 124, "        \"defaultRoles\": [\n          \"user\"\n        ]\n"], [129, 130, "        \"defaultRoles\": [\n          \"user\"\n        ]\n"], [135, 136, "        \"defaultRoles\": [\n          \"user\"\n        ]\n"], [141, 142, "        \"defaultRoles\": [\n          \"user\"\n        ]\n      },\n      {\n        \"name\": \"manage_updates\",\n        \"titleKey\": \"permissions.manage_updates.title\",\n        \"descriptionKey\": \"permissions.manage_updates.description\",\n        \"defaultRoles\": [\n          \"admin\"\n        ]\n"], [199, 200, "    \"uses\": [\n      \"terminal.sidePanel\",\n      \"terminal.toolbar\"\n    ]\n"], [202, 203, "  \"platforms\": [\n    \"linux\",\n    \"win32\",\n    \"darwin\"\n  ]\n"]]}, {"p