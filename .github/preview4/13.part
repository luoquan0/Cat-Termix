nage:false });\n    expect((await server.request(\"PUT\", \"/updates\", {body:{enabled:true,intervalHours:1,proxyUrl:\"\"}})).status).toBe(403);\n    expect((await server.request(\"POST\", \"/updates/apply\", {body:{confirmRestart:true}})).status).toBe(403);\n  });\n  it(\"validates proxy origins and strips unrecognized control fields\", () => {\n    expect(validateUpdatePolicy({enabled:false,intervalHours:6,proxyUrl:\"https://proxy:7890\",command:\"rm\"}))\n      .toEqual({enabled:false,intervalHours:6,proxyUrl:\"https://proxy:7890\"});\n    for (const proxyUrl of [\"file:///etc/passwd\",\"http://localhost/path\",\"https://localhost/?url=other\"])\n      expect(()=>validateUpdatePolicy({enabled:true,intervalHours:1,proxyUrl})).toThrow();\n  });\n});\n"]]}, {"path": "plugins/ai/tests/frontend/AiPanel-settings.test.tsx", "sha256": "c452d1d56ff5585deb5f173a6e14e02f8262e9f4e8da5cc554fa5f7371926d77", "edits": [[10, 10, "vi.mock(\"../../src/frontend/UpdateSettings\", () => ({ UpdateSettings: () => null }));\n"], [80, 81, "      screen.getByRole(\"dialog\", { name: \"ai.chatSettings\" }),\n"], [89, 89, "    const dialog = screen.getByRole(\"dialog\", { name: \"ai.chatSettings\" });\n    expect(dialog.closest(\"[data-slot=dialog-content]\")).toBeTruthy();\n    expect(composer.closest(\"[role=dialog]\")).toBeNull();\n"], [123, 123, "    fireEvent.click(screen.getByRole(\"button\", { name: \"common.close\" }));\n"], [124, 126, ""]]}, {"path": "plugins/ai/tests/frontend/AiSessionControls.test.tsx", "sha256": "a5cb143c2a4840c39a1519d76359ae89c2b2c5b6055ae60f5ca2f92d1c26a8e1", "edits": [[0, 0, "import { ApprovalToggle } from \"../../src/frontend/ApprovalToggle\";\n"], [41, 41, "    <>\n    <ApprovalToggle mode={mode} onChange={setMode} disabled={disabled} />\n"], [47, 49, ""], [51, 51, "    </>\n"], [59, 60, "  it(\"starts in review and explicitly toggles session auto mode with one click\", async () => {\n"], [65, 69, ""], [71, 72, "        .getByRole(\"button\", { name: \"ai.autoModeCompact\" })\n"], [74, 75, "    fireEvent.click(screen.getByRole(\"button\", { name: \"ai.autoModeCompact\" }));\n"]]}, {"path": "src/backend/tests/fixtures/upgrade/upgrade-mysql.sql", "sha256": "0c025f6b76e2a7b4c0d1469da4e8b63bdb21071e000c193e48998002fdad49ec", "edits": [[910, 910, "-- ==== plugin ai 0004_context_checkpoint.sql ====\nALTER TABLE `p_ai_conversations` ADD COLUMN `context_state` text;\n\n"]]}, {"path": "src/backend/tests/fixtures/upgrade/upgrade-postgres.sql", "sha256": "00acc5f996b6bc55f4e45da98120a445ce6c8a98fe6e54befaebdb4df75f34ca", "edits": [[958, 958, "-- ==== plugin ai 0004_context_checkpoint.sql ====\nALTER TABLE \"p_ai_conversations\" ADD COLUMN \"context_state\" text;\n\n"]]}]