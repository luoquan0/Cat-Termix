ifyDigest(Buffer.from('other'),d)); assert.throws(()=>verifyDigest(b,'md5:x'));\n});\ntest('proxy dispatcher is used for redirects but GHCR bearer tokens never leak across hosts', async () => {\n  const calls=[], dispatcher={};\n  const r=new Registry(async(url,options)=>{\n    calls.push({url,options});\n    return calls.length===1 ? new Response(null,{status:307,headers:{location:'https://download.example/layer'}}) : new Response('bytes');\n  },dispatcher); r.token='private-token';\n  await r.get('https://ghcr.io/v2/luoquan0/cat-termix/blobs/sha256:x');\n  assert.equal(calls.length,2);\n  assert.equal(calls[0].options.dispatcher,dispatcher); assert.equal(calls[1].options.dispatcher,dispatcher);\n  assert.equal(calls[0].options.headers.Authorization,'Bearer private-token'); assert.equal(calls[1].options.headers.Authorization,undefined);\n});\ntest('registry redirects cannot downgrade TLS', async () => {\n  const r=new Registry(async()=>new Response(null,{status:307,headers:{location:'http://insecure/layer'}}));\n  await assert.rejects(r.get('https://ghcr.io/test'),/non-HTTPS/);\n});\nconst old = () => ({ Id:'123456789012'.repeat(5), Config:{Image:IMAGE+':ai-dev',Hostname:'123456789012',Env:['PORT=8080'],Labels:{'com.docker.compose.project':'demo','org.opencontainers.image.revision':'old'}},\n  HostConfig:{ Binds:['data:/app/data:rw'],PortBindings:{'8080/tcp':[{HostIp:'127.0.0.1',HostPort:'9080'}]},NetworkMode:'demo_default',RestartPolicy:{Name:'unless-stopped'} },\n  NetworkSettings:{Networks:{demo_default:{Aliases:['cat-termix','123456789012']}}} });\nconst release = { imageRef:IMAGE+':sha-'+'a'.repeat(40),config:{config:{Labels:{'org.opencontainers.image.source':SOURCE,'org.opencontainers.image.revision':'a'.repeat(40)}}} };\ntest('replacement preserves ports, volumes, environment, restart policy and network aliases', () => {\n  const before=old(), c=replacementConfig(before,release);\n  assert.equal(c.Image,release.imageRef);assert.deepEqual(c.Env,before.Config.Env);assert.deepEqual(c.HostConfig,before.HostConfig);\n  assert.equal(c.Hostname,''); assert.equal(c.Labels['com.docker.compose.project'],'demo');assert.equal(c.Labels['org.opencontainers.image.revision'],'a'.repeat(40));\n  assert.deepEqual(c.NetworkingConfig.EndpointsConfig.demo_default.Aliases,['cat-termix']);\n});\ntest('unsupported auto-remove/privileged/network modes are refused before stopping anything', () => {\n  for (const flag of ['Privileged','AutoRemove']) {const c=old();c.HostConfig[flag]=true;assert.throws(()=>replacementConfig(c,release));}\n  const c=old();c.HostConfig.NetworkMode='host';assert.throws(()=>replacementConfig(c,release));\n});\n"]]}, {"path": "docs/cat-termix-ai-preview.md", "sha256": "4a1068f0560bd5c601fd705bd2a2504893af9fd32d7eed1ecb866162b76f7112", "edits": [[0, 1, "# Cat-Termix AI Preview 4 测试版\n"], [2, 3, "开发分支 `Cat-Termix`，基于 2.9.2，不修改 `main`，也不覆盖 `latest`。测试镜像固定使用 `ghcr.io/luoquan0/cat-termix:ai-dev`；发布流水线在全部回归、AMD64/ARM64 构建和启动检查成功后才更新该标签。每次发布保留 `sha-<完整提交 SHA>`，镜像版本标签为 `2.9.2-ai-preview.4`。\n"], [4, 5, "## 独立聊天设置悬浮窗\n"], [6, 7, "聊天顶部保留“助手 / 新对话 / 历史 / 设置”，右侧为上下文占用和审批按钮。设置通过 Portal 打开独立小对话框，不再插入聊天消息区或挤压对话高度；可以关闭按钮或 Esc 关闭。模型发现留在聊天组件中运行，关闭设置不取消加载或清空模型。\n"], [8, 9, "设置里集中提供商、模型列表与刷新、独立/共用 SSH 执行、上下文压缩，以及仅管理员可见的软件更新。提供商管理保留在同一个对话框中。打开窗口、新建对话不会粘贴终端内容，也没有“附加终端输出”按钮。\n"], [10, 11, "## 一键免逐次审批\n"], [12, 13, "对话右侧的“逐次审批”按钮单击切换“免审批”，再次点击恢复。模式仅作用于当前会话，执行过程中不能切换；新建、恢复另一会话时回到审批模式。按钮提示说明自动执行可能修改服务器。\n"], [14, 15, "**免审批不是关闭安全审计、用户权限、主机范围限制或模型服务方的内容政策。** 服务端仍校验权限、记录操作结果，模型不能自行把会话切换成自动模式。\n"], [16, 17, "## 自动上下文压缩与占用\n"], [18, 19, "默认开启。默认容量 **32768 Token**，回复预留 **4096 Token**，压缩阈值 **75%**，优先保留最近 **4 轮**。这些都是用户可配置值，**不是从上游模型自动探测得到的实际容量**；模型别名不代表已知的窗口长度。\n"], [20, 21, "占用显示为“上下文 ~百分比”：\n`(估算输入 Token + 配置的回复预留) / 配置的上下文容量`。\n输入估算计入系统指令、工具定义、历史消息、工具参数/结果以及协议开销；中英文和代码用启发式估算，并非精确 tokenizer。提示中另列上游提供的上次实际输入 Token 数；没有上游 usage 时明确缺省，不将字符估算冒充实际用量。首次请求前显示待统计。\n"], [22, 23, "每次模型调用前（包含工具循环）检查预算。超过阈值时，用当前选中模型、禁用所有工具，分块总结较早会话；保存用户目标、主机与路径、约束、执行状态、报错和未完成工作。优先保留最近完整对话轮及成对的工具调用/结果；必要时减少保留轮数并明确精简过长工具回显的中段。最近用户请求不会被静默删除；即便压缩后仍无法容纳，会报错要求调整容量或缩短请求，而不是假装成功。\n"], [24, 25, "摘要保存在会话检查点中，刷新/重启可恢复。原始聊天数据库消息不删除。摘要失败、为空、异常请求工具或取消时不覆盖原检查点；每个会话串行处理，避免并发覆盖检查点。上游明确报上下文超限时，只对被拒绝的模型请求尝试一次紧急压缩重试，不重新执行已经运行的命令。压缩会额外消耗模型调用与用量，摘要仍可能丢失细节，应查阅完整历史核对重要内容。\n"], [26, 28, "单次任务仍最多 8 轮常规模型调用，压缩调用不计作命令执行轮次；没有固定的聊天消息条数上限，也不声称可无限保留模型记忆。\n"], [29, 30, "## 读取终端与两种执行模式\n"], [31, 32, "`get_terminal_output` 按需读取当前连接或 `@` 主机的最近终端回显，读取记录可见、结果脱敏，不另开连接，也不把回显伪装成用户消息。只读取登录用户自己的已连接会话并重新校验主机访问权限。多会话不混读、过期明确目标不自动换标签页，读取内容有长度限制。\n"], [33, 34, "- **独立执行**：命令走独立 SSH exec 通道，结果在聊天显示，不干扰手动终端。\n- **共用当前 SSH 终端**：在当前可见 PTY 中执行，多行脚本的命令与实际输出显示在左侧，输出/退出状态自动回到模型总结。需空闲 Bash/zsh 提示符；不会注入未输入完的命令、前台程序或断线连接。AI 执行时保留输入，Ctrl+C 中断接管。\n"], [35, 36, "共用模式用同一 PTY 的前台子 Shell 保护连接，避免脚本中的 `exit`/`exec` 退出父 Shell。继承父 Shell 的目录和环境，脚本内 `cd`/`export` 不永久修改父 Shell；依赖这些状态的操作应组合到同一脚本。\n"], [37, 38, "## Docker 自动更新与 HTTP 代理\n"], [39, 40, "这里的“上游更新”是**当前部署自动升级本仓库发布的魔改版镜像**，不是自动合并 Termix 原仓库源码。固定跟踪 `ghcr.io/luoquan0/cat-termix:ai-dev`，避免丢失魔改功能。\n"], [41, 42, "容器不能在没有宿主机 Docker 控制权限时自行替换。为此提供**独立、明确选择启用的更新器**；应用及 AI 进程不挂载 Docker socket。更新器没有网络控制端口，只读取管理员保存的固定格式配置。\n"], [43, 47, "### 首次启用\n\n先保留原数据、环境变量和端口配置，并更新部署目录中的两个 Compose 文件。标准示例使用同一个 `cat-termix-ai-data` 数据卷：\n\n```bash\ngit switch Cat-Termix\ngit pull --ff-only origin Cat-Termix\n# 跟踪滚动测试版；不要继续使用旧的 sha 固定标签。\nexport CAT_TERMIX_IMAGE=ghcr.io/luoquan0/cat-termix:ai-dev\ndocker compose -f docker-compose.ai-test.yml -f docker-compose.ai-updates.yml pull\ndocker compose -f docker-compose.ai-test.yml -f docker-compose.ai-updates.yml up -d\n"], [49, 50, "随后进入聊天设置悬浮窗 → 软件自动更新，保存间隔、代理并按需开启“自动安装”。默认关闭自动安装；支持“立即检查”和确认重启后的“立即更新”。管理员需要 `ai.manage_updates` 和 `admin.settings.manage` 两项权限。软件更新接口不是模型工具，自动执行模式不赋予更新权限。\n"], [51, 52, "默认检查间隔 6 小时，可设 1–168 小时。更新会重启应用并断开 SSH。正在运行的 AI 请求会延后更新，并通过维护握手阻止停机前的新 AI 执行；普通手动 SSH 会话仍会因升级断开，请安排维护时间。\n"], [53, 58, "### 代理与验证\n"], [59, 60, "代理支持 `http://` 和 `https://`，例如 `http://host.docker.internal:7890`。**版本清单、认证和镜像层下载都通过更新器的代理**，不依赖 Docker daemon 的代理环境变量；TLS 校验保持开启。支持 URL 编码的代理认证信息，保存后不回显密码、不写入日志。代理仅影响更新，不修改 AI 上游配置。\n"], [61, 62, "只接受指定 GHCR 仓库的 Linux AMD64/ARM64 镜像，核对源码/提交标签、镜像配置摘要、压缩层和解压层摘要，再通过 Docker API 导入本机。\n"], [63, 64, "### 备份与失败处理\n"], [65, 66, "只自动替换明确标记的同一 Compose 项目中唯一的 Cat-Termix 容器。保存端口、卷、环境、重启策略和网络别名。只支持标准 bridge 网络、持久 `/app/data` 和本地 SQLite；外部数据库、自定义数据路径、静态容器 IP、特权或自动删除容器会拒绝自动替换，需另行安排备份/迁移。\n"], [67, 68, "停机后先做完整本地数据冷备份，再替换容器；新容器通过健康检查才清理旧容器。启动失败时恢复冷备份与旧容器，保留最近 3 份备份，不删除应用数据卷。升级维护窗口期间不要产生新业务写入，失败恢复会回到冷备份时点。\n\n若更新器/宿主机在维护中异常掉电，保留维护日志与冷备份并暂停后续自动更新，不猜测数据状态继续替换。检查更新器的 `/state/journal.json`、`/state/backups/` 和带 `.rollback-` 后缀的旧容器，完成恢复后再移除维护日志。\n\n**Docker socket 相当于宿主机管理权限。** 虽然只有独立更新器挂载它，仍应保护更新器镜像、管理员账号和控制卷，不把 socket 开放到网络。使用自定义绑定目录的部署必须把更新器的 `/backup-source` 调整到同一个真实数据源，代码会核对两边 mount，防止备份错误数据卷。更新器本身作为稳定辅助服务不自动替换自身；未来涉及更新协议变化时需在维护窗口同步更新辅助服务。\n\n## 验证与部署注意\n\n运行 AI/SSH/核心回归；增加压缩失败/取消/协议配对/预算测试、独立弹窗与一键切换测试、更新代理/摘要核对测试，以及真实 Docker 冷备份、容器替换、失败回滚测试。发布仍需双架构容器启动检查。\n\n默认测试地址 `http://localhost:9080`，默认仅绑定本机。需要局域网访问时沿用既有 `CAT_TERMIX_BIND`/端口设置，并限制网络入口。更新后强制刷新网页并重新打开 SSH 会话。自动化验收不等于已连接用户的实际模型网关或 SSH 主机实测。\n"]]}, {"path": "plugins/ai/locales/en.json", "sha256": "d9a4d9cb66b737667453e82424bc48212a0396f7dfc7094fd384e687eb88ab43", "edits": [[21, 21, "    },\n    \"manage_updates\": {\n      \"title\": \"Manage application updates\",\n      \"description\": \"Configure and request opt-in Docker updates; administrator settings permission is also required.\"\n"], [145, 146, "    \"autoModeCompact\": \"Auto execution\",\n"], [148, 149, "    \"readingTerminalOutput\": \"Reading terminal output\",\n    \"disableAutoHint\": \"Click to return to per-command approval. Audit logging and permissions remain enabled.\",\n    \"enableAutoHint\": \"Click to enable automatic execution for this conversation without per-command prompts. Commands can change your server. Audit logging and permissions remain enabled.\",\n    \"settingsDialogHint\": \"Session settings. Close this floating window to retur